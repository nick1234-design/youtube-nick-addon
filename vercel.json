{
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/catalog/:type/:id.json",
      "destination": "/api/catalog/:type/:id"
    },
    {
      "source": "/catalog/:type/:id/:extra*",
      "destination": "/api/catalog/:type/:id/:extra*"
    },
    {
      "source": "/catalog/:type/:id",
      "destination": "/api/catalog/:type/:id"
    },
    {
      "source": "/meta/:type/:id",
      "destination": "/api/meta/:type/:id"
    },
    {
      "source": "/stream/:type/:id",
      "destination": "/api/stream/:type/:id"
    }
  ]
}